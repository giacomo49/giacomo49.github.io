---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog" description="Articles on physics, programming and sport.">
  <section class="stack" style="margin-bottom: 2.5rem;">
    <h1>Blog</h1>
    <p class="muted">
      Notes and articles on physics, programming and training. Newest first.
    </p>
  </section>

  {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">Nothing published yet.</p>}
</BaseLayout>
