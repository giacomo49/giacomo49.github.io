---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SOCIALS } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="stack">
    <h1>Hi, I'm Giacomo Mancuso.</h1>
    <p class="muted">
      I'm 21, I study Physics and I run. In between I write code, and this is where I keep
      the three together: physics notes, training, and small experiments with a computer.
    </p>
  </section>

  <section class="stack" style="margin-top: 3.5rem;">
    <h2>Physics</h2>
    <p class="muted">
      I'm an undergraduate physics student. What interests me most is the point where theory
      turns into a calculation you can actually carry out: analytical mechanics, electromagnetism,
      the first steps into quantum mechanics. I write articles when I understand something well
      enough to explain it — which is usually also the moment I find out I hadn't understood it.
    </p>
  </section>

  <section class="stack" style="margin-top: 2.5rem;">
    <h2>Track and field</h2>
    <p class="muted">
      I compete in track and field. It's the part of my day that can't be optimised on paper:
      you have to show up, repeat, measure, wait. It has taught me more about consistency
      than any productivity book.
    </p>
  </section>

  <section class="stack" style="margin-top: 2.5rem;">
    <h2>Computing &amp; AI</h2>
    <p class="muted">
      I program out of curiosity: numerical simulations, analysis of my training data, tools
      that make studying easier. I follow machine learning and language models closely, on the
      assumption that they are, above all, an excellent way to learn faster. The projects live
      in <a class="link-underline" href="/projects">/projects</a>.
    </p>
  </section>

  {
    posts.length > 0 && (
      <section style="margin-top: 3.5rem;">
        <h2 class="section-title">Latest writing</h2>
        <div style="margin-top: 0.75rem;">
          <PostList posts={posts} />
        </div>
        <p class="small" style="margin-top: 1.25rem;">
          <a class="link-underline muted" href="/blog">All articles &rarr;</a>
        </p>
      </section>
    )
  }

  <section style="margin-top: 3.5rem;">
    <h2 class="section-title">Elsewhere</h2>
    <p class="stack" style="margin-top: 0.75rem;">
      {
        SOCIALS.map((social) => (
          <a class="link-underline" href={social.href} rel="me noopener" target="_blank" style="margin-right: 1.25rem;">
            {social.label} <span class="muted small">{social.handle}</span>
          </a>
        ))
      }
    </p>
  </section>
</BaseLayout>
