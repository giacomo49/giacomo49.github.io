---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const progetti = (await getCollection('progetti', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Progetti" description="Progetti di programmazione, fisica computazionale e AI.">
  <section class="stack" style="margin-bottom: 2.5rem;">
    <h1>Progetti</h1>
    <p class="muted">
      Cose che ho costruito, di solito per risolvere un problema che avevo io.
    </p>
  </section>

  {
    progetti.length > 0 ? (
      <ul class="post-list">
        {progetti.map((progetto) => (
          <li style="padding-block: 1.25rem;">
            <h2 style="font-size: 1.0625rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline;">
              {progetto.data.url ? (
                <a class="link-underline" href={progetto.data.url} target="_blank" rel="noopener">
                  {progetto.data.title}
                </a>
              ) : (
                progetto.data.title
              )}
              <span class="small muted" style="font-variant-numeric: tabular-nums;">
                {progetto.data.date.getFullYear()}
              </span>
            </h2>
            <p class="muted small" style="margin-top: 0.35rem;">{progetto.data.description}</p>
            {progetto.data.tags.length > 0 && (
              <p style="margin-top: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.4rem;">
                {progetto.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">Presto qualcosa da mostrare.</p>
    )
  }
</BaseLayout>
